RESEND_API_KEY=re_xxxxxxxxx
ERROR_REPORT_FROM=ENCBA LOCKER <locker@your-verified-domain.com>
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PUSH_WEBHOOK_SECRET=replace-with-a-long-random-secret
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"replace-with-the-full-private-key"}

# AI 채우기(ai-compose 엣지 함수).
# https://console.groq.com/keys 에서 발급한 키를 넣는다.
# 이 키는 서버(엣지 함수)에만 두고 소스나 앱 빌드에는 절대 넣지 않는다.
GROQ_API_KEY=gsk_xxxxxxxx
# 선택: 쉼표로 여러 개를 적으면 앞에서부터 시도한다.
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
